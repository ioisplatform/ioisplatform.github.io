rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Transactions / Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Study resource / kit records
    match /kits/{kitId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
